{
  "name": "tabuffer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:chrome": "wxt build --browser chrome",
    "build:firefox": "wxt build --browser firefox",
    "package": "npm run package:chrome && npm run package:firefox",
    "package:chrome": "wxt zip --browser chrome",
    "package:firefox": "wxt zip --browser firefox && node scripts/create-firefox-xpi.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "linkedom": "^0.18.13",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wxt": "^0.18.15"
  }
}
